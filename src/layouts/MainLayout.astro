---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Container from "../components/Container.astro";
import Meta from "../components/Meta.astro";

const { contained = true, title, description, image, atUri } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="text-scale" content="scale" />
    <Meta title={title} description={description} image={image} />
    <Font cssVariable="--font-plex" preload />
    <Font cssVariable="--font-plex-condensed" />
    <Font cssVariable="--font-mono" />
    <script
      data-goatcounter="https://lal.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"></script>
    {atUri && <link rel="site.standard.document" href={atUri} />}
    <ClientRouter />
  </head><body>
    <Nav />
    {
      contained ? (
        <Container>
          <slot />
        </Container>
      ) : (
        <slot />
      )
    }
    <Footer />
  </body><style is:global>
    :root {
      --mainAccent: #2429c1;
      --off: #fff;
      --bg: #ededed;
      --fg: #000d3a;
      --fadedGray: color-mix(in srgb, var(--fg), var(--bg) 40%);
      --fadedAccent: color-mix(in srgb, var(--mainAccent), var(--bg) 90%);
      --offWhite: color-mix(in srgb, var(--off), var(--bg) 75%);
      --light-dotted-bg: url("/images/bg/dotted-light.svg");

      --small-spring: 300ms cubic-bezier(0.14, 1.35, 0.29, 0.99);

      @media (prefers-color-scheme: dark) {
        --mainAccent: #9bd0f7;
        --off: #000;
        --bg: #353744;
        --fg: #ececf5;
      }
    }

    .with-dotted-bg {
      position: relative;

      &::before {
        content: "";
        position: absolute;
        inset: 0;
        background-color: color-mix(in srgb, var(--mainAccent), var(--bg) 70%);
        mask: url("/images/bg/dotted-light.svg") repeat;
        z-index: -1;
      }
    }

    * {
      box-sizing: border-box;
    }

    html {
      color: var(--fg);
      font-family: var(--font-plex);
      padding: 0;
    }

    body {
      margin: 0;
      background-color: var(--bg);
      font-size: 16px;
      line-height: 1.5;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    a {
      color: var(--mainAccent);
      text-decoration-color: color-mix(
        in srgb,
        var(--mainAccent),
        transparent 80%
      );
      text-underline-offset: 0.15em;
      text-decoration-thickness: 0.05em;
      transition: text-decoration 0.15s ease-out;

      &:hover {
        text-decoration-color: color-mix(
          in srgb,
          var(--mainAccent),
          transparent 60%
        );
        text-decoration-thickness: 0.15em;
      }
    }

    .from-markdown {
      line-height: 1.75;
      text-rendering: optimizeLegibility;
      position: relative;

      h1,
      h2,
      h3,
      h4 {
        line-height: 1.25;
        margin-top: 2em;
      }

      h1 {
        line-height: 1.1;
        font-size: 1.75em;
      }

      p {
        max-width: 34em;
        margin-bottom: 1.5em;
      }

      /*
        TODO custom markdown rendering that puts
        the images in a full-width <figure> instead
      */
      img {
        max-width: 100%;
      }

      ul,
      ol {
        li {
          max-width: 38em;
        }
      }

      hr {
        margin: 4rem 0;
        border: 0;
        height: 0.125rem;
        background-color: var(--fadedAccent);
        max-width: 36em;
      }

      blockquote {
        background: var(--offWhite);
        margin: 3em 1em;
        padding: 1em 2em;
        position: relative;
        max-width: 42em;

        font-style: italic;
        font-size: 1.2em;

        &::before {
          content: "";
          background: var(--light-dotted-bg) repeat;
          inset: -1em;
          z-index: -1;
          position: absolute;
        }

        @media (max-width: 40em) {
          font-size: 1em;
          padding: 0.5em 1em;
          margin: 3em 1em;
        }
      }

      sup a[aria-describedby="footnote-label"] {
        line-height: 1.4;
        position: relative;
        display: inline-block;
        background-color: var(--fadedAccent);
        color: var(--fg);
        padding: 0 0.2em;
        border-radius: 3px;
        text-decoration: none;
        font-size: 0.65em;
        font-weight: 600;
        transform-origin: 50% calc(100% + 0.75em);
        rotate: 5deg;
        rotate: random(1deg, 11deg);
        translate: 0 -0.5em;
        transition: background-color 0.1s 0.1s ease-out;

        &::before {
          content: "";
          width: 0.2em;
          height: 0.75em;
          background-color: var(--fadedAccent);
          position: absolute;
          top: 100%;
          left: calc(50% - 0.1em);
          transition: background-color 0.1s 0.1s ease-out;
        }

        &::after {
          content: "";
          width: 0.4em;
          height: 0.4em;
          background-color: var(--fadedAccent);
          position: absolute;
          top: calc(100% + 0.5em);
          left: calc(50% - 0.2em);
          border-radius: 0.2em;
          transition: background-color 0.2s ease-out;
        }

        &:hover {
          background-color: var(--mainAccent);
          color: var(--bg);

          &::before,
          &::after {
            background-color: var(--mainAccent);
          }
        }
      }

      section.footnotes {
        margin-top: 4em;
        padding-top: 2em;
        border-top: solid 0.125em var(--fadedAccent);

        h2 {
          font-size: 1.25em;
        }
      }
    }
  </style>
</html>
