---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Container from "../components/Container.astro";
import { Font } from "astro:assets";
import Meta from "../components/Meta.astro";

const { contained = true, title, description, image } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="text-scale" content="scale" />
    <Meta title={title} description={description} image={image} />
    <Font cssVariable="--font-plex" preload />
    <Font cssVariable="--font-plex-condensed" />
    <Font cssVariable="--font-mono" />
    <script
      data-goatcounter="https://lal.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"></script>
  </head>
  <body>
    <Nav />
    {
      contained ? (
        <Container>
          <slot />
        </Container>
      ) : (
        <slot />
      )
    }
    <Footer />
  </body><style is:global>
    :root {
      --mainAccent: #2429c1;
      --bg: #ededed;
      --fg: #000d3a;
      --fadedGray: color-mix(in srgb, var(--fg), var(--bg) 40%);
      --fadedAccent: color-mix(in srgb, var(--mainAccent), var(--bg) 90%);
      --offWhite: color-mix(in srgb, var(--fg), var(--bg) 95%);
      --light-dotted-bg: url("/images/bg/dotted-light.svg");

      --small-spring: 300ms cubic-bezier(0.14, 1.35, 0.29, 0.99);

      @media (prefers-color-scheme: dark) {
        --mainAccent: #9bd0f7;
        --bg: #353744;
        --fg: #ececf5;
      }
    }

    .with-dotted-bg {
      position: relative;

      &::before {
        content: "";
        position: absolute;
        inset: 0;
        background-color: color-mix(in srgb, var(--mainAccent), var(--bg) 70%);
        mask: url("/images/bg/dotted-light.svg") repeat;
        z-index: -1;
      }
    }

    * {
      box-sizing: border-box;
    }

    html {
      color: var(--fg);
      font-family: var(--font-plex);
      padding: 0;
    }

    body {
      margin: 0;
      background-color: var(--bg);
      font-size: 16px;
      line-height: 1.5;
    }

    a {
      color: var(--mainAccent);
      text-decoration-color: color-mix(
        in srgb,
        var(--mainAccent),
        transparent 80%
      );
      text-underline-offset: 0.15em;
      text-decoration-thickness: 0.05em;
      transition: text-decoration 0.15s ease-out;

      &:hover {
        text-decoration-color: color-mix(
          in srgb,
          var(--mainAccent),
          transparent 60%
        );
        text-decoration-thickness: 0.15em;
      }
    }
  </style>
</html>
