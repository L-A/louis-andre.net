---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Container from "../components/Container.astro";
import Meta from "../components/Meta.astro";
import ColorInput from "../components/ColorInput.astro";

const { contained = true, title, description, image, atUri } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="text-scale" content="scale" />
    <Meta title={title} description={description} image={image} />
    <Font cssVariable="--font-plex" preload />
    <Font cssVariable="--font-plex-condensed" />
    <Font cssVariable="--font-mono" />
    <script
      data-goatcounter="https://lal.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"></script>
    {atUri && <link rel="site.standard.document" href={atUri} />}
    <ClientRouter />
  </head><body>
    <Nav />
    <Container>
      <ColorInput />
    </Container>
    {
      contained ? (
        <Container>
          <slot />
        </Container>
      ) : (
        <slot />
      )
    }
    <Footer />

    <style is:global>
      :root {
        --hue: 250deg;
        --mainAccent: oklch(25% 0.45 var(--hue));
        --off: oklch(100% 0.02 var(--hue));
        --bg: oklch(95% 0.005 var(--hue));
        --fg: oklch(10% 0 var(--hue));
        --fadedGray: color-mix(in oklch, var(--fg), var(--bg) 40%);
        --fadedAccent: oklch(
          from color-mix(in oklch, var(--mainAccent), var(--bg) 90%) l calc(c/3)
            h
        );
        --offWhite: color-mix(in oklch, var(--off), var(--bg) 75%);
        --light-dotted-bg: url("/images/bg/dotted-light.svg");

        --small-spring: 300ms cubic-bezier(0.14, 1.35, 0.29, 0.99);

        @media (prefers-color-scheme: dark) {
          --mainAccent: oklch(80% 0.1 var(--hue));
          --off: oklch(5% 0.1 var(--hue));
          --bg: oklch(20% 0.06 var(--hue));
          --fg: oklch(95% 0 var(--hue));
        }
      }

      .with-dotted-bg {
        position: relative;

        &::before {
          content: "";
          position: absolute;
          inset: 0;
          background-color: color-mix(
            in oklch,
            var(--mainAccent),
            var(--bg) 70%
          );
          mask: url("/images/bg/dotted-light.svg") repeat;
          z-index: -1;
        }
      }

      * {
        box-sizing: border-box;
      }

      html {
        color: var(--fg);
        font-family: var(--font-plex);
        padding: 0;
      }

      body {
        margin: 0;
        background-color: var(--bg);
        font-size: 16px;
        line-height: 1.5;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      a {
        color: var(--mainAccent);
        text-decoration-color: color-mix(
          in srgb,
          var(--mainAccent),
          transparent 80%
        );
        text-underline-offset: 0.15em;
        text-decoration-thickness: 0.05em;
        transition: text-decoration 0.15s ease-out;

        &:hover {
          text-decoration-color: color-mix(
            in srgb,
            var(--mainAccent),
            transparent 60%
          );
          text-decoration-thickness: 0.15em;
        }
      }
    </style>
  </body>
</html>
