---
import {
  locales,
  stripLocalePrefix,
  useTranslations,
} from "../helpers/translations";

const { locale, urlFor, t } = useTranslations(Astro.currentLocale);
const bare = stripLocalePrefix(Astro.url.pathname, locale);
const altLang = locales.find((l) => l !== locale) || "en";
const altHref = urlFor(altLang, bare);
---

<a
  class="language-button"
  href={altHref}
  hreflang={altLang}
  lang={altLang}
  aria-label={t("nav.toOtherLanguage")}>{altLang.toUpperCase()}</a
>

<style>
  .language-button {
    display: block;
    text-decoration: none;
    font-size: 0.7rem;
    font-weight: bold;
    opacity: 0.7;
    padding: 0.5rem 0 0.5rem 0.5rem;
    transition: opacity 0.2s ease-out;

    &:hover {
      opacity: 1;
    }
  }
</style>
