---
import IcnSpeedDial from "../assets/svg/icn-speed-dial.svg";
import IcnSpeedNeedle from "../assets/svg/icn-speed-needle.svg";
---

<div class="icon speed-icon">
  <IcnSpeedDial class="dial" />
  <IcnSpeedNeedle class="needle" />
</div>

<style>
  .speed-icon {
    width: 30px;
    display: grid;
    grid-template-areas: "full";
  }

  .speed-icon .dial {
    grid-area: full;
  }

  .speed-icon .needle {
    grid-area: full;
    transform-origin: 50% 82.6%;
    rotate: 0deg;
    transform: rotate(6deg);
    transition: transform var(--small-spring);
  }

  .speed-icon.fast .needle {
    transform: rotate(119deg);
    animation: dial-jitter 0.2s both infinite;
  }

  @keyframes dial-jitter {
    0% {
      rotate: 0deg;
    }
    56% {
      rotate: 10deg;
    }
    100% {
      rotate: 0deg;
    }
  }
</style>
