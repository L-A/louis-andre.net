---
import ButtonLink from "./ButtonLink.astro";
import { useTranslations } from "../helpers/translations";

const { t, url } = useTranslations(Astro.currentLocale);
---

<div class="pages">
  <li>
    <ButtonLink type="highlight" href={url("now")}>{t("nav.now")}</ButtonLink>
  </li>
  <li><ButtonLink href={url("journal")}>{t("nav.journal")}</ButtonLink></li>
  <li><ButtonLink href={url("generative-art")}>{t("nav.art")}</ButtonLink></li>
  <li>
    <ButtonLink href={url("reading-log")}>{t("nav.readingLog")}</ButtonLink>
  </li>
</div>

<style>
  .pages {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;

    li {
      flex: 0 0 auto;
    }
  }
</style>
