---
import Logo from "../assets/svg/l-logo.svg";
import Container from "./Container.astro";
import ButtonLink from "./ButtonLink.astro";

const { currentPath = "/" } = Astro.props;
---

<nav>
  <Container>
    <nav>
      <a href="/" class="home-link" aria-label="Home">
        <Logo />
      </a>
      <p class="current-path">{currentPath}</p>
      <ul class="pages">
        <li>
          <ButtonLink href="/journal">Journal</ButtonLink>
        </li>
        <li>
          <ButtonLink href="/generative-art">Art</ButtonLink>
        </li>
        <li>
          <ButtonLink href="/reading-log">Reading log</ButtonLink>
        </li>
        <li>
          <ButtonLink type="highlight" href="https://petiterevolte.com"
            >Hire me</ButtonLink
          >
        </li>
      </ul>
    </nav>
  </Container>
</nav>

<style>
  nav {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-top: 1rem;

    .home-link {
      svg {
        margin-bottom: -0.18rem;
      }
      margin-right: 0.5rem;
    }

    .current-path {
      color: var(--fadedGray);
      margin-right: auto;
    }

    .pages {
      list-style: none;
      display: flex;
      gap: 0.5rem;
      padding: 0;
    }
  }
</style>
