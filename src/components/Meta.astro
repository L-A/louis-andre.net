---
const {
  title,
  description = "Louis-André's personal website",
  image = "https://louis-andre.net/og-image.jpg",
} = Astro.props;

import { publicationUri } from "../../sequoia.json";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const titleString = (title ? title + " – " : "") + "Louis-André Labadie";
---

{/* Title */}
<title>{titleString}</title>
<meta property="og:title" content={titleString} />
<meta property="twitter:title" content={titleString} />

{/* Description */}
<meta name="description" content={description} />
<meta property="og:description" content={description} />
<meta property="twitter:description" content={description} />

{/* Canonical */}
<link rel="canonical" href={canonicalURL} />
<link rel="me" href="https://social.lol/lalabadie" />

{/* standard.site */}
<link rel="site.standard.publication" href={publicationUri} />

{/* Image */}
<meta property="og:image" content={image} />

{/* Icons */}
<link rel="icon" href="/favicon.ico" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
