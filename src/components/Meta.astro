---
import { getAbsoluteLocaleUrl } from "astro:i18n";
import { publicationUri } from "../../sequoia.json";

import {
  getLocaleAlternates,
  stripLocalePrefix,
  getLocale,
} from "../helpers/translations";

const {
  title,
  description = "Louis-André's personal website",
  image = "https://louis-andre.net/og-image.jpg",
} = Astro.props;

const titleString = (title ? title + " – " : "") + "Louis-André Labadie";

const locale = getLocale(Astro.currentLocale);
const bare = stripLocalePrefix(Astro.url.pathname, locale);
const canonicalURL = getAbsoluteLocaleUrl(locale, bare);
const ogAlternates = getLocaleAlternates(Astro.url.pathname, locale);
const defaultAlternateHref = ogAlternates.find((a) => a.hreflang == "en")?.href;
const ogLocale = locale === "fr" ? "fr_CA" : "en_CA";
---

{/* Title */}
<title>{titleString}</title>
<meta property="og:title" content={titleString} />
<meta property="twitter:title" content={titleString} />

{/* Description */}
<meta name="description" content={description} />
<meta property="og:description" content={description} />
<meta property="twitter:description" content={description} />

{/* Locale */}
<meta property="og:locale" content={ogLocale} />
{
  ogAlternates.map(({ hreflang, href }) => (
    <link rel="alternate" hreflang={hreflang} href={href} />
  ))
}
<link rel="alternate" hreflang="x-default" href={defaultAlternateHref} />

{/* Canonical */}
<link rel="canonical" href={canonicalURL} />
<link rel="me" href="https://social.lol/lalabadie" />

{/* standard.site */}
<link rel="site.standard.publication" href={publicationUri} />

{/* Image */}
<meta property="og:image" content={image} />

{/* Icons */}
<link rel="icon" href="/favicon.ico" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
