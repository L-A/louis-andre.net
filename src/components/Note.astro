---
import { render } from "astro:content";

const { entry, highlight = false } = Astro.props;
const { date, lang } = entry.data;
const { Content } = await render(entry);

import { useTranslations } from "../helpers/translations";
const { urlFor, locale } = useTranslations(Astro.currentLocale);

const dateFormatter = new Intl.DateTimeFormat(locale, {
  year: "numeric",
  month: "long",
  day: "numeric",
  hour: "2-digit",
  minute: "2-digit",
});
---

<article class:list={["feed-item", { highlighted: highlight }]}>
  <main>
    <Content />
  </main>
  <footer>
    <a href={urlFor(locale, `/notes/${entry.id}`)} class="permalink">
      {
        locale !== lang && (
          <span class="language-pill">{lang.toUpperCase()}</span>
        )
      }
      <time datetime={date.toISOString()}>
        {dateFormatter.format(date)}
      </time>
    </a>

    <ul class="links">
      <li>
        <a href="/" class="syndicated">BSKY</a>
      </li>
      /
      <li><a href="/" class="syndicated">MAST</a></li>
      /
      <li><a href="/" class="syndicated">IN</a></li>
    </ul>
  </footer>
</article>

<style>
  .feed-item {
    border-bottom: solid 1px var(--fadedAccent);
    padding: 1rem 0;
    max-width: 36rem;

    &.highlighted {
      background-color: var(--offWhite);
      border: solid 1px var(--fadedAccent);
      border-radius: 0.25rem;
      padding: 1rem;
    }

    main {
      font-size: 1rem;
      line-height: 1.3;

      & > :global(p) {
        margin-top: 0;
      }
    }

    footer {
      color: var(--fadedGray);
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      margin: 0;
      font-size: 0.825rem;

      .permalink {
        .language-pill {
          background: var(--fadedAccent);
          color: var(--mainAccent);
          font-size: 0.8em;
          padding: 0 0.25em;
          border-radius: 0.25em;
          align-self: baseline;
        }

        display: flex;
        flex-direction: row;
        gap: 0.25em;
        color: var(--fadedGray);
        text-decoration: none;
        align-items: baseline;

        time {
          font-size: 0.8rem;
        }
      }

      .links {
        padding: 0;
        margin: 0;
        font-family: var(--font-mono);
        color: var(--fadedAccent);
        list-style: none;
        display: flex;
        flex-direction: row;
        gap: 0.25em;
      }
    }
  }
</style>
