---
import { render } from "astro:content";
import { getSyndication } from "../helpers/syndication";
import { useTranslations } from "../helpers/translations";

const { entry } = Astro.props;
const { date, lang, media = [], plain = false } = entry.data;
const { Content } = await render(entry);

const { urlFor, locale } = useTranslations(Astro.currentLocale);
const s = getSyndication(entry.id);

const dateFormatter = new Intl.DateTimeFormat(locale, {
  year: "numeric",
  month: "long",
  day: "numeric",
  hour: "2-digit",
  minute: "2-digit",
});
---

<article class:list={["feed-item"]}>
  <main>
    {plain ? <div class="plain-text">{entry.body}</div> : <Content />}
  </main>
  {
    media.length > 0 && (
      <div class:list={["media", { multiple: media.length > 1 }]}>
        {media.map((item) =>
          item.type === "video" ? (
            <video
              src={item.src}
              poster={item.poster}
              width={item.width}
              height={item.height}
              controls
              muted
              loop
              playsinline
              preload="metadata"
              data-autoplay-on-scroll
              aria-label={item.alt || undefined}
            />
          ) : (
            <a
              href={item.full ?? item.src}
              target="_blank"
              rel="noopener noreferrer"
            >
              <img
                src={item.src}
                alt={item.alt}
                width={item.width}
                height={item.height}
                loading="lazy"
                decoding="async"
              />
            </a>
          ),
        )}
      </div>
    )
  }
  <footer>
    <a href={urlFor(locale, `/notes/${entry.id}`)} class="permalink">
      {
        locale !== lang && (
          <span class="language-pill">{lang.toUpperCase()}</span>
        )
      }
      <time datetime={date.toISOString()}>
        {dateFormatter.format(date)}
      </time>
    </a>

    <ul class="links">
      {
        s.bluesky && (
          <li>
            <a href={s.bluesky.url} class="syndicated">
              BSKY
            </a>
          </li>
        )
      }
      {
        s.mastodon && (
          <li>
            <a href={s.mastodon.url} class="syndicated">
              MAST
            </a>
          </li>
        )
      }
    </ul>
  </footer>
</article>

<script>
  const videos = document.querySelectorAll<HTMLVideoElement>(
    ".feed-item video[data-autoplay-on-scroll]",
  );
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (videos.length > 0 && !reduceMotion.matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            if (video.ended) video.currentTime = 0;
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        }
      },
      { threshold: 0.5 },
    );

    videos.forEach((video) => observer.observe(video));
  }
</script>

<style>
  .feed-item {
    background-color: var(--offWhite);
    border: solid 1px var(--fadedAccent);
    border-radius: 0.5rem;
    padding: 1rem 1rem 0.5rem;
    max-width: 36rem;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.025);

    main {
      font-size: 1em;
      line-height: 1.3;

      & > :global(p) {
        margin-top: 0;
      }

      .plain-text {
        white-space: pre-wrap;
        overflow-wrap: anywhere;
      }
    }

    .media {
      display: grid;
      gap: 0.5rem;
      margin: 0.5rem 0;

      &.multiple {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      a {
        display: block;
        line-height: 0;
      }

      img,
      video {
        display: block;
        width: 100%;
        height: auto;
        border: solid 1px var(--fadedAccent);
        border-radius: 0.25rem;
      }
    }

    footer {
      color: var(--fadedGray);
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      margin: 0.5rem 0 0;
      font-size: 0.825rem;

      .permalink {
        .language-pill {
          background: var(--fadedAccent);
          color: var(--mainAccent);
          font-size: 0.8em;
          padding: 0 0.25em;
          border-radius: 0.25em;
          align-self: baseline;
        }

        display: flex;
        flex-direction: row;
        gap: 0.25em;
        color: var(--fadedGray);
        text-decoration: none;
        align-items: baseline;

        time {
          font-size: 0.8rem;
        }
      }

      .links {
        padding: 0;
        margin: 0;
        font-family: var(--font-mono);
        color: var(--fadedAccent);
        list-style: none;
        display: flex;
        flex-direction: row;

        li + li {
          &:before {
            content: "/";
            margin: 0 0.25rem;
          }
        }
      }
    }
  }
</style>
