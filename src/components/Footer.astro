---
import Logo from "../assets/svg/l-logo.svg";
import Container from "./Container.astro";
import NavPagesList from "./NavPagesList.astro";
import { getBarePath, useTranslations } from "../helpers/translations";

const { t, url } = useTranslations(Astro.currentLocale);
const countPath = getBarePath(Astro.url.pathname, Astro.currentLocale);
---

<footer>
  <div class="top-separator with-dotted-bg"></div>
  <Container>
    <div class="footer-grid">
      <a href={url("")} class="home-link" aria-label="Home">
        <Logo />
      </a>
      <NavPagesList />
      <ul class="links">
        <li>
          <span class="lead">{t("footer.here")}</span>
          <a class="link" href={url("")}>louis-andre.net</a>
        </li>
        <li>
          <span class="lead">{t("footer.mastodon")}</span>
          <a class="link" href="https://social.lol/@lalabadie"
            >lalabadie@social.lol</a
          >
        </li>
        <li>
          <span class="lead">{t("footer.bluesky")}</span>
          <a class="link" href="https://bsky.app/profile/louis-andre.net"
            >@louis-andre.net</a
          >
        </li>
        <li>
          <span class="lead">{t("footer.work")}</span>
          <a class="link" href="https://petiterevolte.com">petiterevolte.com</a>
        </li>
        <li>
          <span class="lead">{t("footer.visits")}</span>
          <a
            class="link visits-link"
            href="https://lal.goatcounter.com"
            data-visits-path={countPath}
            data-on-this-page={t("footer.onThisPage")}
          >
            lal.goatcounter.com<span></span>
          </a>
        </li>
      </ul>
    </div>
  </Container>

  <style>
    footer {
      padding-top: 4rem;
      margin-top: auto;

      .top-separator {
        height: 4rem;
      }

      .footer-grid {
        display: grid;
        grid-template-areas:
          "home-link links"
          "pages     links";
        gap: 2rem;
        padding: 2rem 0;

        .home-link {
          grid-area: home-link;
        }

        .pages {
          grid-area: pages;
          align-self: end;
          align-items: flex-end;
        }

        .links {
          grid-area: links;

          list-style: none;
          padding: 0;
          margin: 0;
          font-size: 0.875rem;

          li {
            text-align: right;
            margin-bottom: 0.25rem;

            .lead {
              font-weight: 350;
            }

            .link {
              display: inline-block;
              text-align: right;
              width: 10rem;
              color: var(--mainAccent);
              font-weight: 700;

              span {
                font-weight: 400;
              }
            }
          }
        }

        @media (max-width: 40rem) {
          grid-template-areas:
            "home-link pages"
            "links     links";

          .pages {
            justify-self: end;
          }

          .links {
            li {
              .lead {
                text-align: left;
              }
            }
          }
        }
      }
    }
  </style>

  <script>
    document.addEventListener("astro:page-load", () => {
      async function getPageVisits() {
        const startDateString = "2021-01-15";
        const visitsLink = document.querySelector(
          ".visits-link",
        ) as HTMLElement | null;
        if (!visitsLink) return;

        const pagePath =
          visitsLink.dataset.visitsPath ?? window.location.pathname;

        try {
          const response = await fetch(
            `https://stats.louis-andre.net/counter/${pagePath}.json?start=${startDateString}`,
          );
          const { count } = await response.json();
          visitsLink.textContent = `${count}`;

          const visitsSpan = document.createElement("span");
          visitsSpan.textContent =
            " " + (visitsLink.dataset.onThisPage ?? "on this page");
          visitsLink.appendChild(visitsSpan);
        } catch (error) {
          // Visits stat failed to load, we can leave the link as-is
          console.log(
            "Couldn't fetch the page's visit count. It's no biggie, ad-blockers often flag that sort of request. Here's the error:",
            error,
          );
        }
      }

      getPageVisits();
    });
  </script>
</footer>
