---
import MainLayout from "../layouts/MainLayout.astro";
import NavPagesList from "../components/NavPagesList.astro";
import ArrowAgain from "../assets/svg/icn-arrow-again.svg";
---

<MainLayout
  description="Louis-André Labadie's personal website. This is its home page."
>
  <div class="columns">
    <div class="content">
      <div class="top">
        <h1>Hi, I’m Louis-André</h1>
        <p>Welcome! This is my personal site.</p>
        <p>
          We’re probably Internet strangers. It’s a thin connection, but a warm
          one to me nonetheless.
        </p>
      </div>
      <div class="bottom">
        <p>
          I work as an independent designer with organizations that touch on
          tech, games and the arts. My studio is called <a
            href="https://petiterevolte.com">Petite Révolte</a
          >.
        </p>
        <p>
          Browse around, and <a href="mailto:monsieur@louis-andre.net"
            >reach out</a
          > if you’d like!
        </p>
        <h3>For more about *<em>gestures around</em>*</h3>
        <NavPagesList />
      </div>
    </div>
    <div class="art">
      <canvas class="art-canvas"></canvas>
      <div class="controls">
        <button id="speed">Slow</button>
        <button id="grid-scale" data-trait="Grid Scale" type="button"
          >Large</button
        >
        <button id="palette" data-trait="Palette" type="button">Regal</button>
        <button id="shuffle" type="button">Shuffle</button>
        <label class="seed" for="seed">
          Seed #
          <input type="text" id="seed" class="seed" placeholder="none?" />
        </label>
        <button id="new-generation" class="regenerate" type="button"
          ><ArrowAgain /></button
        >
      </div>
    </div>
  </div>
</MainLayout>

<style>
  .columns {
    display: grid;
    grid-template-columns: 1fr 2fr;
    align-items: top;
    gap: 2rem;

    @media (max-width: 48rem) {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .content {
      display: flex;
      flex-direction: column;
      flex: 0 1 20rem;
      justify-content: space-between;
      align-self: stretch;

      .top {
        p {
          font-size: 1.125rem;
        }
      }

      h1 {
        font-size: 1.65rem;
        margin-top: 1rem;
      }

      h3 {
        font-size: 1.1rem;
        margin-top: 1.75rem;
      }

      .pages {
        margin: 0;
      }
    }

    .art {
      margin-top: 1rem;
      flex: 1;
      aspect-ratio: 7/5;
      position: relative;
      overflow: hidden;

      background-color: #ddd;
      border-radius: 0.5rem;
      box-shadow:
        0px 2px 4px rgba(0, 0, 0, 0.1),
        0px 4px 8px rgba(0, 0, 0, 0.1);

      .art-canvas {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
      }

      .controls {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        position: absolute;
        inset: 0.25rem;
        top: auto;
        overflow: hidden;
        background-color: var(--offWhite);
        border-radius: 0.25rem;
        box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.1);
        padding: 0;
        box-shadow:
          0px 4px 4px rgba(0, 0, 0, 0.15),
          inset 0px 1px 0px #ffffff;
        border-radius: 4px;

        button {
          appearance: none;
          border: none;
          background: transparent;
          font: inherit;
          font-family: var(--font-mono);

          color: var(--fadedGray);
          text-decoration: underline;
          text-decoration-color: color-mix(
            in srgb,
            var(--fadedGray),
            transparent 40%
          );

          border-right: solid 1px
            color-mix(in srgb, var(--fadedGray), transparent 70%);
          border-radius: 0.125rem;
          padding: 0.35rem 0.5rem;
          cursor: pointer;
          display: flex;
          vertical-align: baseline;
          box-shadow: 1px 0px 0px #ffffff;
          transition:
            background-color 0.2s ease-out,
            color 0.2s ease-out;

          svg {
            vertical-align: middle;
          }

          &:hover {
            color: var(--mainAccent);
            background-color: white;
          }
        }

        .seed {
          color: var(--fadedGray);
          font: inherit;
          font-family: var(--font-mono);
          margin-left: auto;
          display: flex;
          align-items: center;

          input {
            background: transparent;
            border: none;
            border-radius: 0.125rem;
            padding: 0.1rem 0.5rem;
            field-sizing: content;
          }
        }
      }
    }
  }
</style>

<script>
  import "../assets/script/canvas.js";
</script>
