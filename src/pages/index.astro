---
import MainLayout from "../layouts/MainLayout.astro";
import NavPagesList from "../components/NavPagesList.astro";

import ArrowAgain from "../assets/svg/icn-arrow-again.svg";
import ShuffleIcon from "../assets/svg/icn-shuffle.svg";
import SpeedIcon from "../components/SpeedIcon.astro";
import GridIcon from "../components/GridIcon.astro";
import PaletteIcon from "../components/PaletteIcon.astro";
---

<MainLayout
  description="Louis-André Labadie's personal website. This is its home page."
>
  <div class="columns">
    <div class="content">
      <div class="top">
        <h1>Hi, I’m Louis-André</h1>
        <p>Welcome! This is my personal site.</p>
        <p>
          We’re probably Internet strangers. It’s a thin connection, but a warm
          one to me nonetheless.
        </p>
      </div>
      <div class="bottom">
        <p>
          I work as an independent designer with organizations that touch on
          tech, games and the arts. My studio is called <a
            href="https://petiterevolte.com">Petite Révolte</a
          >.
        </p>
        <p>
          Browse around, and <a href="mailto:monsieur@louis-andre.net"
            >reach out</a
          > if you’d like!
        </p>
        <h3>For more about *<em>gestures around</em>*</h3>
        <NavPagesList />
      </div>
    </div>
    <div class="art">
      <canvas class="art-canvas"></canvas>
      <div class="controls">
        <button id="shuffle" type="button"><ShuffleIcon /></button>
        <button id="grid-scale" type="button">
          <GridIcon />
        </button>
        <button id="palette" data-trait="Palette" type="button">
          <PaletteIcon />
        </button>
        <label class="seed" for="seed">
          <span class="lg">Seed </span>#
          <input type="text" id="seed" class="seed" placeholder="none?" />
        </label>
        <button id="new-generation" class="regenerate" type="button"
          ><ArrowAgain /></button
        >
        <button id="speed"><SpeedIcon /></button>
      </div>
    </div>
  </div>
</MainLayout>

<style>
  .columns {
    display: grid;
    grid-template-columns: 1fr 2fr;
    align-items: top;
    gap: 2rem;

    @media (max-width: 48rem) {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .content {
      display: flex;
      flex-direction: column;
      flex: 0 1 20rem;
      justify-content: space-between;
      align-self: stretch;

      .top {
        p {
          font-size: 1.125rem;
        }
      }

      h1 {
        font-size: 1.65rem;
        margin-top: 1rem;
      }

      h3 {
        font-size: 1.1rem;
        margin-top: 1.75rem;
      }

      .pages {
        margin: 0;
      }
    }

    .art {
      margin-top: 1rem;
      flex: 1;
      aspect-ratio: 7/5;
      position: relative;
      overflow: hidden;

      background-color: #ddd;
      border-radius: 0.5rem;
      box-shadow:
        0px 2px 4px rgba(0, 0, 0, 0.1),
        0px 4px 8px rgba(0, 0, 0, 0.1);

      .art-canvas {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
      }

      .controls {
        position: absolute;
        inset: 0.25rem;
        top: auto;

        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        overflow: hidden;
        background-color: var(--offWhite);
        border-radius: 0.25rem;
        box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.1);
        padding: 0;
        box-shadow:
          0px 4px 4px rgba(0, 0, 0, 0.15),
          inset 0px 1px 0px #ffffff;
        border-radius: 4px;

        button {
          appearance: none;
          border: none;
          background: transparent;
          font: inherit;
          font-family: var(--font-mono);

          display: flex;
          align-items: center;
          justify-content: center;
          padding: 0.35rem 0.5rem;
          min-width: 3rem;
          vertical-align: baseline;

          color: var(--fadedGray);
          text-decoration: underline;
          text-decoration-color: color-mix(
            in srgb,
            var(--fadedGray),
            transparent 40%
          );

          border-right: solid 1px
            color-mix(in srgb, var(--fadedGray), transparent 70%);
          border-radius: 0.125rem;
          cursor: pointer;
          box-shadow: 1px 0px 0px #ffffff;
          transition:
            background-color 0.2s ease-out,
            color 0.2s ease-out;

          .icon {
            vertical-align: middle;
            margin: 0 auto;
          }

          &:hover {
            color: var(--mainAccent);
            background-color: white;
          }

          &:active {
            .icon {
              transition:
                scale 0.05s ease-out,
                translate 0.2s ease-out;
              scale: 0.95;
              translate: 0 1px;
            }
          }
        }

        .seed {
          color: var(--fadedGray);
          font: inherit;
          font-family: var(--font-mono);
          display: flex;
          align-items: center;
          padding: 0 1rem;
          margin-left: auto;

          input {
            background: transparent;
            border: none;
            border-radius: 0.125rem;
            padding: 0.1rem 0.5rem;
            field-sizing: content;
          }
        }
      }
    }
    @media (max-width: 480px) {
      .art {
        display: flex;
        flex-direction: column;
        aspect-ratio: unset;
        overflow: visible;
        box-shadow: none;
        background: none;

        .art-canvas {
          border-radius: 0.5rem;
          position: static;
          width: 100%;
          aspect-ratio: 7/5;

          box-shadow:
            0px 2px 4px rgba(0, 0, 0, 0.1),
            0px 4px 8px rgba(0, 0, 0, 0.1);
        }

        .controls {
          background: none;
          box-shadow: none;
          position: static;
          inset: unset;
          top: unset;
          margin-top: 0.5rem;
          padding: 0 0 1rem;

          .seed {
            padding: 0 0.25rem;

            .lg {
              display: none;
            }
          }

          button {
            padding: 0.1rem 0rem;
            min-width: 2.4rem;
            border: none;
            box-shadow: none;
            border-radius: 4px;

            .icon {
              scale: 0.85;
            }
          }
        }
      }
    }
  }
</style>

<script>
  import "../assets/script/canvas.js";
</script>
