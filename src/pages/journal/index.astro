---
import { getCollection, type CollectionEntry } from "astro:content";

import MainLayout from "../../layouts/MainLayout.astro";
import RssIcon from "../../assets/svg/icn-rss.svg";
import { useTranslations } from "../../helpers/translations";

const { url, l, locale } = useTranslations(Astro.currentLocale);
const entries = await getCollection("journal");

const groupedByYear = entries.reduce<
  Record<number, CollectionEntry<"journal">[]>
>((acc, entry) => {
  const year = entry.data.date.getFullYear();
  (acc[year] ??= []).push(entry);
  return acc;
}, {});
---

<MainLayout
  title="Journal"
  description={l({
    en: "A list of texts and articles I wrote over the years.",
    fr: "Les articles que j'ai écrits au fil des ans.",
  })}
>
  <header>
    <h2>
      Journal{" "}
      <a class="feed-link" href="/journal/rss.xml">
        <RssIcon class="rss-icon" />
      </a>
    </h2>
    {
      l({
        en: (
          <>
            <p>Here is where I write occasional articles.</p>
            <p>
              I also have a newsletter called{" "}
              <a href="https://buttondown.com/Kind">The Kind Dispatch</a>, which
              I regularly maintained until I became a father a few years ago. I
              want to come back to it eventually.{" "}
              <a href="https://buttondown.com/Kind/archive">The archives</a> are
              available in the meantime.
            </p>
          </>
        ),
        fr: (
          <>
            <p>C'est ici que j'écris occasionnellement des articles.</p>
            <p>
              J'ai aussi une infolettre nommée{" "}
              <a href="https://buttondown.com/Kind">The Kind Dispatch</a>. Je
              l'ai maintenue régulièrement jusqu'à ce que je devienne papa il y
              a quelques années. Je veux y revenir éventuellement, et{" "}
              <a href="https://buttondown.com/Kind/archive">ses archives</a>{" "}
              sont disponibles d'ici à ce que ça arrive.
            </p>
          </>
        ),
      })
    }
  </header>

  <ul class="entries">
    {
      Object.entries(groupedByYear)
        .sort(([a], [b]) => Number(b) - Number(a))
        .map(([year, entries]) => (
          <li class="year">
            <h3 class="with-dotted-bg">{year}</h3>
            <ul>
              {entries
                .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
                .map((entry) => (
                  <li class="entry">
                    <a href={url(`journal/${entry.id}`)}>
                      <h4>
                        {entry.data.title}
                        {entry.data.lang !== locale && (
                          <>
                            {" "}
                            <span class="language-tag">{entry.data.lang}</span>
                          </>
                        )}
                      </h4>
                      <p>{entry.data.description}</p>
                    </a>
                  </li>
                ))}
            </ul>
          </li>
        ))
    }
  </ul>
</MainLayout>

<style>
  header {
    max-width: 48rem;

    margin-bottom: 2rem;

    h2 {
      font-size: 1.5rem;

      a {
        opacity: 0.6;
        transition: opacity 0.15s;

        &:hover {
          opacity: 1;
        }

        .rss-icon {
          margin-left: 0.5rem;
          width: 1.1rem;
          height: 1.1rem;
        }
      }
    }

    p {
      font-size: 1.125rem;
      max-width: 36rem;
    }
  }

  ul.entries {
    max-width: 48rem;
    list-style: none;
    padding: 0;

    .year {
      ul {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      h3 {
        color: var(--mainAccent);
        font-family: var(--font-mono);
        margin: 1rem -1rem;
        padding: 0.25rem 1rem;
      }

      .entry {
        margin: 2rem 0;

        a {
          display: block;
          color: var(--fg);
          text-decoration: none;

          h4 {
            margin: 0;
            font-size: 1.25rem;
            max-width: 36rem;

            .language-tag {
              display: inline-block;
              text-transform: uppercase;
              font-size: 0.7rem;
              padding: 0 0.1rem;
              color: var(--mainAccent);
              background-color: var(--offWhite);
              vertical-align: middle;
            }
          }

          p {
            margin: 0;
            max-width: 36rem;
          }

          &:hover {
            h4 {
              color: var(--mainAccent);
              text-decoration: underline;

              .language-tag {
                text-decoration: none;
              }
            }

            p {
              color: color-mix(var(--fg), transparent 40%);
            }
          }
        }
      }
    }
  }
</style>
