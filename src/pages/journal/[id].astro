---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCollection, render } from "astro:content";
import { useTranslations } from "../../helpers/translations";

export const getStaticPaths = async () => {
  const entries = await getCollection("journal");
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
};

const { locale, l } = useTranslations(Astro.currentLocale);
const { entry } = Astro.props;
const { Content } = await render(entry);

const dateFormatter = new Intl.DateTimeFormat(locale, {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<MainLayout
  title={entry.data.title}
  description={entry.data.description}
  atUri={entry.data.atUri}
>
  <article class="main-content">
    <h1 class="title">
      {entry.data.title}
    </h1>
    <h2 class="date">
      <span>{l({ en: "Posted", fr: "Publié le" })}</span>
      {" " + dateFormatter.format(entry.data.date)}
    </h2>
    <main class="from-markdown">
      <Content />
    </main>
  </article>
</MainLayout>

<style>
  .main-content {
    font-size: 1.125rem;

    h1.title {
      font-size: 2.5rem;
      font-family: var(--font-plex-condensed);
      margin: 1.5rem 0 1rem;
      line-height: 1.1;
      margin-left: -0.025rem;

      @media (max-width: 40rem) {
        margin-top: 1rem;
      }
    }

    h2.date {
      font-family: var(--font-mono);
      font-weight: normal;
      font-size: 1rem;
      margin: 0.25rem 0 2rem;

      span {
        color: var(--fadedGray);
      }
    }
  }
</style>
