---
import MainLayout from "../layouts/MainLayout.astro";
import { render, getCollection } from "astro:content";
import { Image } from "astro:assets";

import Image1 from "../../public/portfolio/galleyhouse-placeholder-1@2x.png";
import Image2 from "../../public/portfolio/galleyhouse-placeholder-2@2x.png";

const workExperience = await getCollection("workExperience");
---

<MainLayout
  title="Journal"
  description="A list of texts and articles I wrote over the years."
>
  <div class="content-root">
    <header>
      <h2>Resume</h2>
      <p class="intro">
        Colleagues call me <em>a designer?</em> and <em>a developer?</em> – pronouncing
        the question mark on both. I design for screens most of the time, and I develop
        for the front-end when a project calls for it. My best work is done when I
        get to cover both the design and development roles.
      </p>
      <p>
        While I love a good marketing website, I usually fit best with work done
        on products with complex user interfaces, and when I can integrate into
        a small, competent product and development team.
      </p>
    </header>

    <label class="portfolio-mode" for="portfolio-mode">
      <div class="toggle-slider">
        <div class="toggle-knob"></div>
      </div>
      <input type="checkbox" id="portfolio-mode" class="hidden" />
      Portfolio mode is <span class="mode-state-string">off</span>
    </label>

    <h3 class="with-dotted-bg">Projects and portfolio</h3>
    <ul class="portfolio">
      {
        workExperience
          .sort((a, b) => b.data.timePeriod.localeCompare(a.data.timePeriod))
          .map(async (item) => {
            const { Content } = await render(item);
            return (
              <li class="portfolio-project escapes-container">
                <div class="container">
                  <div class="content">
                    <div class="intro">
                      <h4>{item.data.name}</h4>
                      <p class="time-period">
                        <strong>{item.data.timePeriod}</strong> /{" "}
                        {item.data.responsibilities}
                      </p>
                    </div>
                    <div class="description">
                      <Content />
                    </div>
                    <div class="material">
                      <Image src={Image1} alt={"Screenshot"} />
                      <Image src={Image2} alt={"Screenshot"} />
                    </div>
                  </div>
                </div>
              </li>
            );
          })
      }
    </ul>

    <h3 class="with-dotted-bg">Clients and workplaces</h3>
    <ul class="experience">
      {
        workExperience
          .sort((a, b) => b.data.timePeriod.localeCompare(a.data.timePeriod))
          .map(async (item) => {
            const { Content } = await render(item);
            return (
              <li class="work-item">
                <h4>{item.data.name}</h4>
                <p class="time-period">
                  <strong>{item.data.timePeriod}</strong> /{" "}
                  {item.data.responsibilities}
                </p>
                <div class="content">
                  <Content />
                </div>
              </li>
            );
          })
      }
    </ul>

    <h3 class="with-dotted-bg">Relevant skills</h3>
    <ul class="skills">
      <li>
        <h4>0 → 1 product design</h4>
        <p>
          Working with small teams and founders, I’ve become very good at
          helping people go from <em>I have an idea</em> to <em
            >I know exactly what we’re going to do</em
          >. I treat design as the (fun, difficult) act of planning how to turn
          an idea and vision into something that’s ready to get implemented.
        </p>
      </li>
      <li>
        <h4>User experience</h4>
        <p>
          I’ve been structuring apps since before <em>UX</em> became the <em
            >mot du jour</em
          > with leadership. My work involves defining user flows, auditing existing
          solutions. In particular, I make sure that whatever process gets moved to
          a digital equivalent actually improves on its current analog.
        </p>
      </li>
      <li>
        <h4>Interface design</h4>
        <p>
          I make personality coexist with function. I build strong interfaces by
          making them visually clear, strong in their identity and branding, and
          by making sure they’re easy to use with the right mix of organization
          and visual cues.
        </p>
      </li>
      <li>
        <h4>Front-of-the-front-end</h4>
        <p>
          I take part in developing the final interface. Usually, I’m at my best
          when I support a front-end team or person, and contribute with code
          that directly controls the appearance of the intercace. For
          small-scale web projects, I sometimes take charge of complete
          development.
        </p>
      </li>
    </ul>

    <h3 class="with-dotted-bg">Can we talk?</h3>
    <p>
      Of course! The best way to reach me is <a
        href="mailto:monsieur@louis-andre.net">by email</a
      >. I'm also on <a href="https://bsky.app/profile/louis-andre.net"
        >Bluesky</a
      > and
      <a href="https://www.linkedin.com/in/louis-andre-labadie">LinkedIn</a> if that's
      your preference.
    </p>
  </div>
</MainLayout>

<style>
  header {
    max-width: 52rem;

    margin-bottom: 2rem;

    h2 {
      font-size: 2.5rem;
      font-family: var(--font-plex-condensed);
      margin: 1.5rem 0 1rem;
      line-height: 1.1;
      margin-left: -0.025rem;
    }

    p {
      font-size: 1.125rem;
      max-width: 40em;
    }

    p.intro {
      font-weight: 350;
      font-size: 1.375rem;
      line-height: 1.45;
    }
  }

  h3 {
    color: var(--mainAccent);
    font-family: var(--font-mono);
    margin: 3rem -1rem 1rem;
    padding: 0.5rem 1rem;
    font-size: 1rem;
  }

  .portfolio-mode {
    color: var(--mainAccent);
    font-weight: bold;
    display: flex;
    flex-direction: row;

    input {
      display: none;
    }

    .toggle-slider {
      --spacing: 0.125rem;
      --size: 1.5rem;

      background-color: transparent;
      border: solid 1px var(--mainAccent);
      width: calc(var(--size) * 1.6);
      height: calc(var(--size) + var(--spacing));
      margin-right: 0.25em;
      border-radius: calc((var(--size) + var(--spacing)) / 2);
      padding: var(--spacing);

      transition: background-color 0.2s ease-out;

      .toggle-knob {
        background-color: var(--mainAccent);
        border-radius: calc((var(--size) - var(--spacing)) / 2);
        height: calc(var(--size) - var(--spacing) * 2);
        width: calc(var(--size) - var(--spacing) * 2);

        transition:
          background-color 0.2s ease-out,
          margin-left var(--small-spring);
      }
    }

    &:has(input:checked) {
      .toggle-slider {
        background-color: var(--mainAccent);

        .toggle-knob {
          background-color: var(--bg);
          margin-left: calc(var(--size) * 0.5);
        }
      }
    }

    .mode-state-string {
      margin-left: 0.25em;
    }
  }

  ul.portfolio {
    list-style: none;
    padding: 0;

    .portfolio-project {
      .container {
        display: flex;
        flex-direction: row;

        overflow-x: scroll;
        overflow-y: hidden;
        overflow-y: hidden;
        scrollbar-width: none;

        margin: 0.5rem 0.25rem;
        background-color: #000;
        border-radius: 0.75rem;
        height: min(24rem, 80vh);

        .content {
          position: relative;
          color: #ddd;
          display: flex;
          flex-direction: row;
          align-items: stretch;
          flex: 0 0 auto;
          padding-right: 8rem;

          gap: 2rem;

          .intro,
          .description,
          .material {
          }

          .intro {
            padding-left: 2rem;
            flex: 0 0 min(16rem, 80vw);
            display: flex;
            flex-direction: column;
            justify-content: flex-end;

            h4 {
              font-size: 3rem;
              font-weight: 200;
              line-height: 1;
              margin: 0;
            }

            .time-period {
              font-size: 0.85rem;
              font-family: var(--font-mono);
              color: var(--mainAccent);
              align-self: baseline;
            }
          }

          .description {
            flex: 0 0 min(32rem, 80vw);
            align-self: flex-end;
          }

          .material {
            display: flex;
            flex-direction: row;

            img {
              max-height: 100%;
              width: auto;
            }
          }
        }
      }
    }
  }

  ul.experience {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;

    li {
      padding-top: 1rem;
      display: grid;
      gap: 0.5rem 1rem;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto;
      grid-template-areas:
        "a b"
        "c c";

      h4,
      .time-period {
        align-self: baseline;
        padding-bottom: 0;
        margin: 0;
      }

      h4 {
        font-family: var(--font-plex-condensed);
        font-weight: 300;
        font-size: 1.45rem;
        grid-area: a;
      }

      .time-period {
        font-size: 0.85rem;
        font-family: var(--font-mono);
        color: var(--mainAccent);
        grid-area: b;
        align-self: baseline;
      }

      .content {
        border-top: solid 1px var(--fadedAccent);
        grid-area: c;
        padding-left: calc(50% + 0.5rem);
        font-size: 0.875rem;
      }

      @media (max-width: 600px) {
        padding-top: 2rem;
        grid-template-columns: 1fr;
        grid-template-areas: "a" "b" "c";

        .content {
          padding: 0;
        }
      }
    }
  }

  ul.skills {
    list-style: none;
    margin-top: 2rem;
    padding: 0;
    display: grid;
    gap: 2rem 1rem;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto;

    @media (max-width: 600px) {
      grid-template-columns: 1fr;
    }

    h4 {
      color: var(--mainAccent);
      font-weight: 300;
      font-size: 1.5rem;
      margin: 0;
    }
  }

  .portfolio {
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    // Portfolio switch
    const portfolioSwitch = document.querySelector(
      "#portfolio-mode",
    ) as HTMLInputElement;
    portfolioSwitch.addEventListener("change", () => {
      const value = portfolioSwitch.checked;
      const modeSpan = document.querySelector(".mode-state-string");
      const pageRoot = document.querySelector(".content-root");

      if (value) {
        if (modeSpan) modeSpan.innerHTML = "on";
        if (pageRoot) pageRoot.classList.add("portfolio");
      } else {
        if (modeSpan) modeSpan.innerHTML = "off";
        if (pageRoot) pageRoot.classList.remove("portfolio");
      }
    });

    // Items animation
    const containers = document.querySelectorAll(
      ".portfolio-project .container",
    );

    containers.forEach((container) => {
      const rate = Math.random() * 0.2 + 0.9;
      container.setAttribute("rate", rate);
      const original = container.querySelector(".content");
      if (!original) return;

      const clone = original.cloneNode(true) as HTMLDivElement;
      clone.setAttribute("aria-hidden", "true");
      clone.inert = true;
      container.appendChild(clone);

      const loopWidth = original.getBoundingClientRect().width;

      // keeps native drag/wheel scrolling on the container looping too
      container.addEventListener(
        "scroll",
        () => {
          if (container.scrollLeft >= loopWidth) {
            container.scrollLeft -= loopWidth;
          } else if (container.scrollLeft <= 0) {
            container.scrollLeft += loopWidth;
          }
        },
        { passive: true },
      );
    });

    // push vertical page-scroll delta into each item's horizontal scroll
    let lastY = window.scrollY;
    window.addEventListener(
      "scroll",
      () => {
        const deltaY = window.scrollY - lastY;
        lastY = window.scrollY;

        containers.forEach((container, i) => {
          container.scrollLeft += deltaY * ((i % 3) + 1) * 0.3;
        });
      },
      { passive: true },
    );
  });
</script>
